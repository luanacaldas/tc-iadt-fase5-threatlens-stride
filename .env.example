# Local API
BACKEND_PORT=8000
FLOW_STRATEGY=legacy
FRONTEND_API_BASE_URL=/api

# Supervised detector
YOLO_MODEL_PATH=models/threatlens-hybrid-v2/weights/best.pt
YOLO_MIN_DETECTION_CONFIDENCE=0.35
YOLO_CONFIDENCE_THRESHOLD=0.70
YOLO_CALIBRATION_PATH=models/component-confidence-calibration.json

# Optional override. Windows standard installation paths are discovered automatically.
TESSERACT_CMD=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
MAX_IMAGE_SIZE_MB=25
MAX_IMAGE_PIXELS=40000000
MAX_JSON_SIZE_MB=2
MAX_COMPONENTS=200
MAX_FLOWS=1000
MAX_TRUST_BOUNDARIES=100
MAX_FIELD_LENGTH=300
MAX_REPORT_THREATS=500
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Remote AI is opt-in. Keep false for the fully local, zero-cost pipeline.
ENABLE_VISION_FALLBACK=false
ENABLE_GENERATIVE_REPORTS=false
ENABLE_REMOTE_VALIDATION=false

# Required only when the corresponding remote feature is enabled.
GEMINI_API_KEY=
GROQ_API_KEY=
