{
  "name": "threatlens-ai",
  "version": "1.0.0-mvp",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build:web": "node scripts/build_frontend.mjs",
    "test:web": "node --test tests/test_web_mvp.mjs",
    "start:backend": ".venv\\Scripts\\uvicorn backend.main:app --host 0.0.0.0 --port 8000 --reload",
    "dev": "node scripts/start-dev.mjs",
    "analyze:sample": "node scripts/analyze-sample.mjs",
    "dataset:kaggle:audit": ".venv\\Scripts\\python scripts/audit_kaggle_dataset.py",
    "dataset:kaggle:plan": ".venv\\Scripts\\python scripts/download_kaggle_subset.py",
    "dataset:kaggle:prepare": ".venv\\Scripts\\python scripts/prepare_kaggle_dataset.py",
    "dataset:kaggle:prepare:unique": ".venv\\Scripts\\python scripts/prepare_kaggle_dataset.py --source dataset/raw_kaggle_selected --output dataset/kaggle_curated_unique --max-augmentations-per-group 1 --link-mode hardlink",
    "dataset:hybrid:build": ".venv\\Scripts\\python scripts/merge_yolo_datasets.py --source current=dataset --source kaggle_unique=dataset/kaggle_curated_unique --output dataset/hybrid_v2 --link-mode hardlink",
    "dataset:hybrid:audit": ".venv\\Scripts\\python scripts/analyze_dataset_balance.py --data dataset/hybrid_v2/architecture.yaml",
    "dataset:replay:build": ".venv\\Scripts\\python scripts/create_replay_manifest.py",
    "training:bundle": ".venv\\Scripts\\python scripts/create_training_bundle.py",
    "test": ".venv\\Scripts\\python -m unittest discover -s tests -v",
    "test:backend": ".venv\\Scripts\\python -m unittest tests.test_backend_pipeline -v",
    "test:dataset": ".venv\\Scripts\\python -m unittest tests.test_kaggle_dataset_tools -v",
    "train:yolo": ".venv\\Scripts\\python scripts/train_yolo.py",
    "model:evaluate": ".venv\\Scripts\\python scripts/evaluate_model.py",
    "model:evaluate:sources": ".venv\\Scripts\\python scripts/evaluate_source_slices.py",
    "model:register": ".venv\\Scripts\\python scripts/register_model.py",
    "benchmark:structure:build": ".venv\\Scripts\\python scripts/build_structure_benchmark.py",
    "benchmark:structure:evaluate": ".venv\\Scripts\\python scripts/evaluate_structure_benchmark.py",
    "benchmark:stride": ".venv\\Scripts\\python scripts/evaluate_stride_golden_set.py",
    "benchmark:real": ".venv\\Scripts\\python scripts/evaluate_real_architecture_benchmark.py",
    "benchmark:blind": ".venv\\Scripts\\python scripts/evaluate_blind_end_to_end.py",
    "benchmark:real:build": ".venv\\Scripts\\python scripts/build_expanded_real_benchmark.py",
    "benchmark:real:audit": ".venv\\Scripts\\python scripts/audit_real_benchmark_integrity.py",
    "benchmark:fiap:correct": ".venv\\Scripts\\python scripts/build_corrected_fiap_benchmark.py",
    "benchmark:end-to-end:summary": ".venv\\Scripts\\python scripts/summarize_end_to_end_improvements.py",
    "benchmark:v15:gate": ".venv\\Scripts\\python scripts/check_v15_regression.py",
    "benchmark:prospective:audit": ".venv\\Scripts\\python scripts/audit_prospective_v12.py",
    "train:arrowheads": ".venv\\Scripts\\python scripts/train_arrowhead_classifier.py",
    "dataset:active-learning": ".venv\\Scripts\\python scripts/build_active_learning_dataset.py",
    "repro:manifest": ".venv\\Scripts\\python scripts/build_reproducibility_manifest.py",
    "verify": ".venv\\Scripts\\python scripts/verify_project.py",
    "smoke": ".venv\\Scripts\\python scripts/smoke_test.py --base-url http://127.0.0.1:4173/api --expected-strategy legacy",
    "verify:full": ".venv\\Scripts\\python scripts/verify_project.py --full",
    "model:compare:active": ".venv\\Scripts\\python scripts/compare_active_learning_models.py",
    "model:calibrate": ".venv\\Scripts\\python scripts/calibrate_component_confidence.py",
    "report:sample-pdf": ".venv\\Scripts\\python scripts/generate_sample_pdf.py",
    "offline:package": ".venv\\Scripts\\python scripts/package_offline_demo.py",
    "train:pipeline": ".venv\\Scripts\\python scripts/run_training_pipeline.py"
  },
  "description": "MVP for AI-assisted STRIDE threat modeling from software architecture diagrams."
}
